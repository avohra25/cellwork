{erl_opts, [debug_info, warnings_as_errors]}.

{escript_main_app, cellwork}.
{escript_name, cellwork}.

{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used,
               deprecated_function_calls, deprecated_functions]}.

%% yecc always emits return_error/2, used or not.
{xref_ignores, [{cell_parser, return_error, 2}]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling]}]}.

{profiles, [{test, [{erl_opts, [debug_info]}]}]}.
